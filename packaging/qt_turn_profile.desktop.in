[Desktop Entry]
Type=Application
Name=Turn Profile
Comment=Simulate micromouse turn profiles
Exec=@DEPLOY_BIN_DIR@/@PROJECT_NAME@
Icon=@DEPLOY_ICON@
Terminal=false
Categories=Science;Math;
StartupWMClass=@PROJECT_NAME@
Actions=uninstall;

[Desktop Action uninstall]
Name=Uninstall
Exec=@DEPLOY_UNINSTALL@
