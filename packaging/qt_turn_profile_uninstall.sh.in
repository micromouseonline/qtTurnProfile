#!/bin/sh
# Uninstall @PROJECT_NAME@ as installed by the 'deploy' target. Generated by CMake.
# Removes only the files 'deploy' created, then this script.
# Asks first: in the terminal if run from one, else with kdialog or zenity.
# With no way to ask, nothing is removed.

BIN="@DEPLOY_BIN_DIR@/@PROJECT_NAME@"
ICON="@DEPLOY_ICON@"
DATA_DIR="@DEPLOY_DATA_DIR@"
DESKTOP="@DEPLOY_APPS_DIR@/@PROJECT_NAME@.desktop"
SELF="@DEPLOY_UNINSTALL@"

MSG="Remove Turn Profile?

$BIN
$ICON
$DESKTOP
$SELF"

if [ -t 0 ]; then
    printf '%s\n[y/N] ' "$MSG"
    read -r answer
    case "$answer" in
        y | Y | yes | Yes) ;;
        *) echo "Nothing removed."; exit 1 ;;
    esac
elif command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Turn Profile" --warningyesno "$MSG" || exit 1
elif command -v zenity >/dev/null 2>&1; then
    zenity --question --title="Turn Profile" --text="$MSG" || exit 1
else
    exit 1
fi

rm -f "$BIN" "$ICON" "$DESKTOP"
rmdir "$DATA_DIR" 2>/dev/null  # only if now empty

# refresh the application menu: Plasma caches entries (ksycoca); others use the desktop database
if command -v kbuildsycoca6 >/dev/null 2>&1; then
    kbuildsycoca6 >/dev/null 2>&1
elif command -v kbuildsycoca5 >/dev/null 2>&1; then
    kbuildsycoca5 >/dev/null 2>&1
fi
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "@DEPLOY_APPS_DIR@" >/dev/null 2>&1
fi

rm -f "$SELF"
